group = ano)) +
geom_line(size = 0.7, linetype = "longdash") +
scale_x_continuous(limits = c(1, 53), breaks = seq(1, 53, by = 4)) +
scale_y_continuous(limits = c(0, max(tabela_semana$n))) +
scale_color_manual(values = c("darkblue", "darkorange", "firebrick", "forestgreen","black")) +
labs(
x = "Epidemiology week",
y = "Number of cases",
color = "Year"
) +
theme_minimal() +  theme(legend.position = "right")
# Gráfico de barras
ggplot(comp_ano, aes(x = ano, y = percentual, fill = comportamento)) +
geom_col(position = position_dodge(width = 0.7), width = 0.7, color = "black") +
scale_fill_brewer(palette = "Set2") +
scale_y_continuous(limits = c(0,100), breaks = seq(0,100,20)) +
theme_minimal(base_size = 12) +
labs(
x = "",
y = "Percentual (%)",
fill = "Comportamento Sexual"
) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
legend.position = "center",
panel.grid.minor = element_blank()
)
# Gráfico levando em consideração a semana epidemiológica por Região e ano
dados <-  read_delim("Downloads/Artigos/Dados Mpox/dados_usados_mpox.csv",
delim = ";", escape_double = FALSE, trim_ws = TRUE)
# Gráfico levando em consideração a semana epidemiológica por Região e ano
dados <-  read_delim("Downloads/Artigos/Dados Mpox/dados_usados_mpox.csv",
delim = ";", escape_double = FALSE, trim_ws = TRUE)
# Gráfico levando em consideração a semana epidemiológica por Região e ano
dados <-  read_delim("~/Downloads/Dados Mpox/dados_usados_mpox.csv",
delim = ";", escape_double = FALSE, trim_ws = TRUE)
# Visualização dos dados
View(dados)
# Tratamento e Mapeamento das Regiões
dados_processados <- dados %>%
# Remove registos sem ano, semana ou estado
filter(!is.na(ano), !is.na(ano_semana), !is.na(sg_uf), sg_uf != "") %>%
# Mapeia as UFs para as Regiões do Brasil
mutate(
regiao = case_when(
sg_uf %in% c("AC", "AP", "AM", "PA", "RO", "RR", "TO") ~ "North",
sg_uf %in% c("AL", "BA", "CE", "MA", "PB", "PE", "PI", "RN", "SE") ~ "Northeast",
sg_uf %in% c("DF", "GO", "MT", "MS") ~ "Midwest",
sg_uf %in% c("ES", "MG", "RJ", "SP") ~ "Southeast",
sg_uf %in% c("PR", "RS", "SC") ~ "South",
TRUE ~ NA_character_
),
# Extrai o número numérico da Semana Epidemiológica (ex: "2022-S45" -> 45)
semana_epidem = as.numeric(str_extract(ano_semana, "(?<=S)\\d+")),
# Converte o ano para fator para melhor visualização/agrupamento
ano = as.factor(ano)
) %>%
filter(!is.na(regiao), !is.na(semana_epidem))
# Agrupamento para contar o número de casos por Ano, Região e Semana
casos_por_semana <- dados_processados %>%
count(ano, regiao, semana_epidem, name = "num_casos")
# Construção do Gráfico no ggplot2 - Gráfico de linhas
ggplot(casos_por_semana, aes(x = semana_epidem, y = num_casos, color = regiao, group = regiao)) +
geom_line(linewidth = 0.9) +
geom_point(size = 1.3, alpha = 0.7) +
# Cria painéis separados para cada Ano
facet_wrap(~ ano, ncol = 2, scales = "free_y") +
# Paleta de cores adaptada e legível
scale_color_brewer(palette = "Set1") +
scale_x_continuous(breaks = seq(1, 53, by = 5)) +
theme_minimal(base_size = 12) +
labs(
title = "Número de Casos de Mpox por Semana Epidemiológica",
#subtitle = "Evolução comparativa por Região e Ano",
x = "Semana Epidemiológica",
y = "Número de Cases",
color = "Region"
) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5, color = "gray40"),
legend.position = "top",
panel.grid.minor = element_blank(),
strip.text = element_text(face = "bold", size = 11)
)
# Gráfico de barras
ggplot(casos_por_semana, aes(x = semana_epidem, y = num_casos, fill = regiao)) +
geom_col(position = "stack", width = 0.8) +
# Separa os painéis por Ano
facet_wrap(~ ano, ncol = 2, scales = "free_y") +
# Paleta de cores para preenchimento
scale_fill_brewer(palette = "Set1") +
scale_x_continuous(breaks = seq(1, 53, by = 5)) +
theme_minimal(base_size = 12) +
labs(
#title = "Distribuição Semanal de Casos de Mpox por Região",
#subtitle = "Número total de casos por semana epidemiológica acumulado por região",
x = "Epidemiological week",
y = "Number of cases",
fill = "Region"
) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5, color = "gray40"),
legend.position = "top",
panel.grid.minor = element_blank(),
strip.text = element_text(face = "bold", size = 11)
)
