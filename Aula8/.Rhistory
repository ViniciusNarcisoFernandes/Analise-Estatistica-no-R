library(ggplot2)
library(dplyr)
# Organizando os dados
casos_por_semana <- casos_por_semana %>%
mutate(
ano = as.integer(ano),
semana_epidem = as.integer(semana_epidem)
) %>%
arrange(ano, semana_epidem)
# Criando uma variável para o eixo temporal
semanas <- casos_por_semana %>%
distinct(ano, semana_epidem) %>%
arrange(ano, semana_epidem) %>%
mutate(posicao = row_number())
# Associando as posições aos dados
casos_grafico <- casos_por_semana %>%
left_join(semanas, by = c("ano", "semana_epidem"))
# Gráfico de barras empilhadas
ggplot(casos_grafico,
aes(x = posicao, y = num_casos, fill = regiao)) +
geom_col(width = 0.85) +
scale_fill_brewer(palette = "Set1") +
# Identificação dos anos no eixo X
scale_x_continuous(
breaks = semanas %>%
group_by(ano) %>%
summarise(posicao = mean(range(posicao)),
.groups = "drop") %>%
pull(posicao),
labels = sort(unique(semanas$ano))
) +
theme_minimal(base_size = 12) +
labs(
x = "Year",
y = "Number of cases",
fill = "Region"
) +
theme(
legend.position = "top",
panel.grid.minor = element_blank()
)
# Construção do Gráfico no ggplot2 - Gráfico de linhas
ggplot(casos_por_semana, aes(x = semana_epidem, y = num_casos, color = regiao, group = regiao)) +
geom_line(linewidth = 0.9) +
geom_point(size = 1.3, alpha = 0.7) +
# Cria painéis separados para cada Ano
facet_wrap(~ ano, ncol = 2, scales = "free_y") +
# Paleta de cores adaptada e legível
scale_color_brewer(palette = "Set1") +
scale_x_continuous(breaks = seq(1, 53, by = 5)) +
theme_minimal(base_size = 12) +
labs(
title = "Número de Casos de Mpox por Semana Epidemiológica",
#subtitle = "Evolução comparativa por Região e Ano",
x = "Semana Epidemiológica",
y = "Número de Cases",
color = "Region"
) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5, color = "gray40"),
legend.position = "top",
panel.grid.minor = element_blank(),
