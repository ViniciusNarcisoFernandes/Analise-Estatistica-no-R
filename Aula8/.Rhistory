# Realizando a Análise Descritiva dos dados
df_usados <- read_delim("~/Downloads/Dados Mpox/dados_usados_mpox.csv",
delim = ";", escape_double = FALSE, trim_ws = TRUE)
df_usados
# Comparando a forma da epidemia em cada ano
dados_tempo <- df_usados %>%
filter(!is.na(dt_sin_pri)) %>%
mutate(
ano = year(dt_sin_pri),
semana = isoweek(dt_sin_pri)
)
# Tabela com mês e semana epidemiologica
tabela_semana <- dados_tempo %>% count(ano, semana, name = "n")
# Gráfico comparando a epidemia em cada ano
ggplot(data = tabela_semana, aes(x = semana, y = n,
color = factor(ano),
group = ano)) +
geom_line(size = 0.7, linetype = "longdash") +
scale_x_continuous(limits = c(1, 53), breaks = seq(1, 53, by = 4)) +
scale_y_continuous(limits = c(0, max(tabela_semana$n))) +
scale_color_manual(values = c("darkblue", "darkorange", "firebrick", "forestgreen","black")) +
labs(
x = "Epidemiology week",
y = "Number of cases",
color = "Year"
) +
theme_minimal() +  theme(legend.position = "right")
# O perfil de comportamento sexual registrado entre pessoas com mpox mudou entre 2022 e 2026?
comp_ano <- df_usados %>%
filter(!is.na(ano),
comp_sexual %in% c(1,2,3)) %>%
mutate(
comportamento = factor(
comp_sexual,
levels = c(1,2,3),
labels = c(
"Relações com Homens",
"Relações com Mulheres",
"Relações com Ambos"
)
),
ano = factor(ano)
) %>%
count(ano, comportamento) %>%
group_by(ano) %>%
mutate(percentual = 100 *n/sum(n))
# Gráfico de barras
ggplot(comp_ano, aes(x = ano, y = percentual, fill = comportamento)) +
geom_col(position = position_dodge(width = 0.7), width = 0.7, color = "black") +
scale_fill_brewer(palette = "Set2") +
scale_y_continuous(limits = c(0,100), breaks = seq(0,100,20)) +
theme_minimal(base_size = 12) +
labs(
x = "",
y = "Percentual (%)",
fill = "Comportamento Sexual"
) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
legend.position = "center",
panel.grid.minor = element_blank()
)
